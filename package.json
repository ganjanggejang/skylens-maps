{
  "name": "cities-maps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-data.mjs",
    "predev": "npm run prepare:data",
    "dev": "vite --host localhost --port 3000 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "npm run prepare:data",
    "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build --mode mod",
    "preview": "vite preview --host localhost --port 3000 --strictPort"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "geotiff": "^3.0.5",
    "pngjs": "^7.0.0",
    "proj4": "^2.22.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.0.1"
  }
}
